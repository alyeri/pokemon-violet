# Core listener and Nextendo account service
NPLN_LISTEN=0.0.0.0:443
CERT_FILE=cert.pem
KEY_FILE=key.pem
NPLN_CA_CERT_FILE=ca-cert.pem
NPLN_CA_KEY_FILE=ca-key.pem
NPLN_CERT_PROFILE=observed
NPLN_ALLOW_LEGACY_SIGNER=0
NPLN_ALLOW_UNVERIFIED=0
NEXTENDO_ACCOUNT_URL=http://127.0.0.1:18080
NEXTENDO_SECRET=
NEXTENDO_INTERNAL_KEY=
NPLN_JWT_KEY=npln_jwt_violet_es256.key

# Client-facing session and latency endpoints
NPLN_GAMESESSION_HOST=127.0.0.1
NPLN_GAMESESSION_PORT=443
NPLN_LATENCY_HOST=127.0.0.1
NPLN_LATENCY_PORT=443

# STUN and authenticated TURN
NPLN_STUN_LISTEN=127.0.0.1:3478
NPLN_STUN_HOST=127.0.0.1
NPLN_STUN_PORT=3478
NPLN_TURN_LISTEN=127.0.0.1:3479
NPLN_TURN_HOST=127.0.0.1
NPLN_TURN_PORT=3479
NPLN_TURN_RELAY_IP=127.0.0.1
NPLN_TURN_REALM=nextendo.local
NPLN_TURN_USERNAME=nextendo
NPLN_TURN_PASSWORD=change-this-password

# NNCS NAT check
NPLN_NNCS_ENABLED=1
NEXTENDO_NNCS1_IP=127.0.0.1
NEXTENDO_NNCS2_IP=127.0.0.2
NEXTENDO_NAT_IP=127.0.0.2
NPLN_NNCS_LOCAL_IP=127.0.0.1

# Pokémon Violet Ranked Battles
VIOLET_RANKED_DISCOVERY_MODE=regulated
VIOLET_RANKED_RESOURCE_MODE=regulated
VIOLET_RANKED_MAIN_IMAGE=/path/to/legally-obtained/violet-3.0.1-main.bin
VIOLET_RANKED_STATE_FILE=ranked-state.json

# Runtime limits and private diagnostics
NPLN_UNKNOWN_RPC_MODE=unimplemented
NPLN_MAX_MESSAGE_BYTES=33554432
NPLN_TLS_HANDSHAKE_TIMEOUT=10s
NPLN_UDP_OBSERVE_ADDRS=off
VIOLET_PROBE_DIR=runtime/logs
