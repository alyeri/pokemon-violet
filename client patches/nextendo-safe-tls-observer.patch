+        private static byte[] GatherPrefix(ArraySegment<byte>[] buffers, int length)
+        {
+            int available = 0;
+            foreach (ArraySegment<byte> buffer in buffers)
+            {
+                available += buffer.Count;
+                if (available >= length) break;
+            }
+
+            byte[] result = new byte[Math.Min(available, length)];
+            int copied = 0;
+            foreach (ArraySegment<byte> buffer in buffers)
+            {
+                int count = Math.Min(buffer.Count, result.Length - copied);
+                if (count <= 0) break;
+                buffer.AsSpan(0, count).CopyTo(result.AsSpan(copied));
+                copied += count;
+            }
+            return result;
+        }
